{
  "name": "circles",
  "private": true,
  "description": "circles",
  "license": "MIT",
  "scripts": {
    "start": "turbo build -- --filter @circles/web  & turbo start -- --filter @circles/web",
    "dev": "turbo dev",
    "worker:start": "turbo start -- --filter @circles/worker",
    "database:generate": "yarn workspace @circles/database generate",
    "database:migrate": "yarn workspace @circles/database migrate",
    "format:check": "prettier --check .",
    "format:write": "prettier --write --list-different .",
    "lint": "eslint --ext \".ts,.vue\" --ignore-path .gitignore .",
    "lint:fix": "yarn lint --fix"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=16.14.0"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^5.61.0",
    "eslint": "^8.44.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^4.2.1",
    "prettier": "^3.0.0",
    "turbo": "^1.10.3",
    "typescript": "^5.1.6"
  }
}
