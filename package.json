{
  "name": "circles",
  "private": true,
  "description": "circles",
  "license": "MIT",
  "scripts": {
    "start": "turbo --filter @circles/web build & turbo --filter @circles/web start",
    "dev": "turbo --filter @circles/web run dev",
    "worker:start": "turbo --filter @circles/worker start",
    "database:generate": "turbo --filter @circles/database generate",
    "database:migrate": "turbo --filter @circles/database migrate",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint:check": "eslint --ext \".ts,.vue\" --ignore-path .gitignore .",
    "lint": "prettier --write --list-different . && turbo lint --fix"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=16.14.0"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^5.61.0",
    "eslint": "^8.44.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^4.2.1",
    "prettier": "^3.0.0",
    "turbo": "^1.10.3",
    "typescript": "^5.1.6"
  }
}
