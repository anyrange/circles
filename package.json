{
  "name": "circles",
  "version": "1.0.0",
  "description": "",
  "license": "MIT",
  "scripts": {
    "start": "pnpm --filter web build & pnpm --filter web start",
    "dev": "pnpm --filter web run dev",
    "worker:start": "pnpm --filter worker start",
    "database:generate": "pnpm --filter database generate",
    "database:migrate": "pnpm --filter database migrate",
    "lint": "eslint --ext \".ts,.vue\" --ignore-path .gitignore .",
    "format": "prettier --check .",
    "lint:fix": "prettier --write --list-different . && pnpm lint --fix",
    "preinstall": "npx only-allow pnpm"
  },
  "packageManager": "pnpm@8.0.0",
  "engines": {
    "node": ">=16.14.0"
  },
  "devDependencies": {
    "@nuxtjs/eslint-config-typescript": "^12.0.0",
    "@typescript-eslint/parser": "^5.57.0",
    "eslint": "^8.36.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^4.2.1",
    "prettier": "^2.8.7",
    "typescript": "^4.9.4"
  }
}
