    "postinstall": "pnpm --filter database generate"
  },
  "packageManager": "pnpm@7.25.1",
  "engines": {
    "node": ">=16.14.0"
  },
  "devDependencies": {
    "@nuxtjs/eslint-config-typescript": "^12.0.0",
    "@typescript-eslint/parser": "^5.57.0",
    "eslint": "^8.36.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^4.2.1",
    "prettier": "^2.8.7",
    "typescript": "^4.9.4"
  }
}
