{
  "name": "circles",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "vp fmt",
    "lint": "vp lint --fix",
    "type-check": "vp run -r type-check",
    "ready": "vp check",
    "verify": "vp check && vp run -r test && vp run -r build",
    "coverage": "run-p coverage:backend coverage:frontend",
    "coverage:backend": "vp run @circles/backend#test:coverage",
    "coverage:frontend": "vp run @circles/frontend#test:coverage",
    "dev": "run-p dev:frontend dev:api dev:worker",
    "dev:frontend": "pnpm --filter @circles/frontend dev",
    "dev:api": "pnpm --filter @circles/backend dev:api",
    "dev:worker": "pnpm --filter @circles/backend dev:worker",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "infra:reset": "pnpm infra:down && docker run --rm -v \"$PWD/data:/data\" alpine:3.22 rm -rf /data/postgres /data/rustfs && pnpm infra:up",
    "db:generate": "pnpm --filter @circles/backend db:generate",
    "db:migrate": "pnpm --filter @circles/backend db:migrate",
    "db:seed": "pnpm --filter @circles/backend db:seed",
    "db:reset": "pnpm --filter @circles/backend db:reset",
    "db:studio": "pnpm --filter @circles/backend db:studio",
    "start:api": "pnpm --filter @circles/backend start:api",
    "start:worker": "pnpm --filter @circles/backend start:worker"
  },
  "devDependencies": {
    "@oxlint/plugins": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "npm-run-all2": "catalog:",
    "oxlint": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.32.1"
}
