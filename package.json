  "license": "MIT",
  "scripts": {
    "database": "pnpm --filter database",
    "web": "pnpm --filter web",
    "worker": "pnpm --filter worker",
    "api": "pnpm --filter spotify-api",
    "lint": "eslint --ext \".ts,.vue\" --ignore-path .gitignore .",
    "format": "prettier --check .",
