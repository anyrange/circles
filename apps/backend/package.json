{
  "name": "@circles/backend",
  "version": "1.0.0",
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run --hot src/index.ts",
    "database:generate": "drizzle-kit generate:pg --schema=./src/services/database/postgres/schema.ts --out=./src/services/database/drizzle",
    "database:migrate": "dotenv -e .env -- bun run ./scripts/database/migrate.ts",
    "database:print-info": "dotenv -e .env -- bun run ./scripts/database/info.ts",
    "database:flush": "dotenv -e .env -- bun run ./scripts/database/flush.ts",
    "lint": "eslint src",
    "lint-fix": "eslint src --fix",
    "format-check": "prettier --check .",
    "format": "prettier --write .",
    "postinstall": "stale-dep -u"
  },
  "dependencies": {
    "@circles/utils": "file:../../packages/ts/utils",
    "@hono/zod-validator": "^0.2.2",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.30.10",
    "envalid": "^8.0.0",
    "globals": "^15.2.0",
    "hono": "^4.5.5",
    "postgres": "^3.4.4",
    "zod": "^3.23.7"
  },
  "devDependencies": {
    "@circles/types": "file:../../packages/ts/types",
    "@total-typescript/ts-reset": "^0.5.1",
    "@types/bun": "latest",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "dotenv-cli": "^7.4.1",
    "drizzle-kit": "^0.20.18",
    "eslint": "^9.2.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.5",
    "stale-dep": "^0.7.0",
    "typescript": "^5.4.5"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  }
}
