{
  "name": "@circles/backend",
  "version": "0.0.0",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0 && prettier --check src/",
    "fix": "eslint . --fix && prettier --write src/",
    "database:generate": "drizzle-kit generate:pg --schema=./src/services/database/postgres/schema.ts --out=./src/services/database/drizzle",
    "database:migrate": "dotenv -e .env -- bun run ./scripts/database/migrate.ts",
    "database:print-info": "dotenv -e .env -- bun run ./scripts/database/info.ts",
    "database:flush": "dotenv -e .env -- bun run ./scripts/database/flush.ts"
  },
  "dependencies": {
    "@circles/utils": "workspace:*",
    "@hono/node-server": "^1.12.0",
    "@hono/zod-validator": "^0.2.2",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.30.10",
    "envalid": "^8.0.0",
    "hono": "^4.5.5",
    "postgres": "^3.4.4",
    "zod": "^3.23.7"
  },
  "devDependencies": {
    "@circles/eslint-config": "workspace:*",
    "@circles/prettier-config": "workspace:*",
    "@circles/tsconfig": "workspace:*",
    "@circles/types": "workspace:*",
    "@total-typescript/ts-reset": "^0.5.1",
    "@types/node": "^22.4.0",
    "dotenv-cli": "^7.4.1",
    "drizzle-kit": "^0.20.18",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "tsx": "^4.7.1",
    "typescript": "^5.5.3"
  }
}
