{
  "name": "@circles/backend",
  "version": "1.0.0",
  "scripts": {
    "start": "ts-node index.ts",
    "database:generate": "drizzle-kit generate:pg --schema=./services/database/postgres/schema.ts --out=./services/database/drizzle",
    "database:migrate": "dotenv -e .env -- ts-node ./scripts/database/migrate.ts",
    "database:print-info": "dotenv -e .env -- ts-node ./scripts/database/info.ts",
    "database:flush": "dotenv -e .env -- ts-node ./scripts/database/flush.ts",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format-check": "prettier --check .",
    "format": "prettier --write .",
    "postinstall": "stale-dep -u"
  },
  "dependencies": {
    "@circles/types": "../../packages/ts/types",
    "@circles/utils": "../../packages/ts/utils",
    "@hono/node-server": "^1.9.1",
    "@hono/trpc-server": "^0.1.1",
    "@trpc/server": "^10.9.0",
    "dotenv": "^16.0.3",
    "drizzle-orm": "^0.27.0",
    "envalid": "^7.3.1",
    "hono": "^4.2.3",
    "jsonwebtoken": "^9.0.1",
    "node-fetch": "^2.6.1",
    "postgres": "^3.3.5",
    "zod": "^3.20.2"
  },
  "devDependencies": {
    "@total-typescript/ts-reset": "^0.5.1",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^20.4.1",
    "@types/node-fetch": "^2.6.2",
    "@typescript-eslint/eslint-plugin": "^7.6.0",
    "@typescript-eslint/parser": "^7.0.0",
    "dotenv-cli": "^7.4.1",
    "drizzle-kit": "^0.19.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-prettier": "^4.2.1",
    "prettier": "^3.0.0",
    "stale-dep": "^0.7.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  }
}
