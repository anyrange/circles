{
  "name": "@circles/frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev --port 3000",
    "build": "vp build",
    "preview": "vp preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "type-check": "tsc --noEmit",
    "test": "vp run test:unit && vp run test:browser",
    "test:unit": "vp test run --config vitest.unit.config.ts --passWithNoTests",
    "test:browser": "vp test run --config vitest.browser.config.ts --passWithNoTests",
    "test:coverage": "vp test run --config vitest.unit.config.ts --coverage --passWithNoTests",
    "test:e2e": "playwright test"
