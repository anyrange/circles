generator client {
    provider        = "prisma-client-js"
    previewFeatures = ["fieldReference", "clientExtensions"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
    id             String  @id
    display_name   String  @unique
    email          String  @default("")
    avatar         String  @default("")
    country        String
    privacy        Privacy @default(public)
    filter_enabled Boolean
    url            String
    product        String
    type           String

    access_token      String
    refresh_token     String
    last_login        DateTime @default(now())
    registration_date DateTime @default(now())

    history  History[]
    Follows  Follows[] @relation("follower")
    Followed Follows[] @relation("followee")
}

model Follows {
    id          Int    @id @default(autoincrement())
    follower    User   @relation(name: "follower", fields: [follower_id], references: [id], onDelete: Cascade)
    follower_id String
    followee    User   @relation(name: "followee", fields: [followee_id], references: [id], onDelete: Cascade)
    followee_id String
}

model History {
    id        Int      @id @default(autoincrement())
    played_at DateTime
    track     Track    @relation(fields: [track_id], references: [id], onDelete: Cascade)
    track_id  String
    user      User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
    user_id   String
}

model Track {
    id           String   @id
    name         String
    duration_ms  Int
    release_date DateTime
    popularity   Float
    track_number Int
    disc_number  Int
    preview_url  String
    url          String
    is_local     Boolean
    explicit     Boolean

    Album         Album          @relation(fields: [album_id], references: [id], onDelete: Cascade)
    album_id      String
    Artist        Artist[]
    Images        Images         @relation(fields: [images_id], references: [id])
    images_id     Int            @unique
    AudioFeatures AudioFeatures?
    History       History[]
}

model Album {
    id                     String    @id
    name                   String
    release_date           DateTime
    release_date_precision String
    label                  String
    popularity             Float
    album_type             AlbumType
    url                    String
    total_tracks           Int

    genres    Genre[]
    Images    Images  @relation(fields: [images_id], references: [id])
    images_id Int     @unique
    Track     Track[]
}

model Artist {
    id         String @id
    name       String
    followers  Int
    url        String
    popularity Float

    genres    Genre[]
    Images    Images  @relation(fields: [images_id], references: [id])
    images_id Int     @unique
    Track     Track[]
}

model Images {
    id     Int     @id @default(autoincrement())
    high   String
    medium String
    low    String
    Artist Artist?
    Track  Track?
    Album  Album?
}

model AudioFeatures {
    tempo            Float
    energy           Float
    loudness         Float
    dancebility      Float
    instrumentalness Float
    acousticness     Float
    speechiness      Float
    liveness         Float
    valence          Float

    Track    Track? @relation(fields: [track_id], references: [id])
    track_id String @id
}

model Genre {
    id     Int      @id @default(autoincrement())
    name   String   @unique
    Album  Album[]
    Artist Artist[]
}

enum Privacy {
    public
    private
}

enum AlbumType {
    album
    single
    compilation
}
